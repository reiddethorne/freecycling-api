# Copy this file to .env, replace the example values, and load it into your
# shell before starting the application. Never commit your real .env file.

DATABASE_URL=jdbc:mysql://localhost:3306/freecycling?useSSL=false&allowPublicKeyRetrieval=true
DATABASE_USERNAME=freecycling
DATABASE_PASSWORD=replace-with-your-database-password
PASSWORD_PEPPER=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional overrides used by the integration test profile.
TEST_DATABASE_URL=jdbc:mysql://localhost:3306/freecycling?useSSL=false&allowPublicKeyRetrieval=true
TEST_DATABASE_USERNAME=freecycling
TEST_DATABASE_PASSWORD=replace-with-your-test-database-password
TEST_PASSWORD_PEPPER=test-only-pepper
TEST_JWT_SECRET=test-only-jwt-secret-must-be-at-least-32-characters
